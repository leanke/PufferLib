# CRPG-specific build flags for build_env.sh
# Requires libcrpg_sim.a built in advance:
#   cmake -B ../crpg/build -S ../crpg -DCRPG_HEADLESS=ON -DCRPG_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release
#   cmake --build ../crpg/build --target crpg_sim -j$(nproc)

CRPG_SRC="$(realpath "$(dirname "${BASH_SOURCE[0]}")/../../../crpg")"
EXTRA_CFLAGS="-I${CRPG_SRC}/src -DCRPG_HEADLESS=1"
EXTRA_LDFLAGS="-L${CRPG_SRC}/build/src -lcrpg_sim"
